# Copy to .env and fill in. Never commit .env.
JSM_SITE=https://your-site.atlassian.net
JSM_EMAIL=you@example.com
JSM_API_TOKEN=
JSM_SERVICE_DESK_ID=
ANTHROPIC_API_KEY=
# or, if you use Gemini instead:
GEMINI_API_KEY=

# PayPal sandbox (Phase 3B). Sandbox only, fake money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# 1 = judges' mode: tickets from data/payment_tickets.csv, no Jira needed
DEMO_MODE=0
